PORT=4000
CORS_ORIGIN=http://localhost:5173

# Token buat endpoint privat /api/history (riwayat UID + berapa kali dipakai).
# Kosong = endpoint-nya DIKUNCI. Isi pakai string acak, mis. hasil: openssl rand -hex 24
ADMIN_TOKEN=

# Enka.Network
ENKA_BASE_URL=https://enka.network
# Enka minta User-Agent yang jelas + kontak. Ganti sesuai punyamu.
ENKA_USER_AGENT=GenshinBuildChecker/0.1 (personal project; your-email@example.com)
# TTL cache per-UID (detik). Enka cooldown ~60s untuk UID yang sama.
ENKA_CACHE_TTL_SECONDS=90

# LLM — OPSIONAL, default MATI. Kalau di-hosting biarin mati biar kuota API-mu nggak kepakai orang lain.
# Nyalain: LLM_ENABLED=true DAN isi LLM_API_KEY. Semua kalkulator tetap jalan tanpa ini.
LLM_ENABLED=false
# endpoint OpenAI-compatible (/chat/completions). Default DeepSeek.
# Ganti provider cukup ubah 3 baris ini: OpenAI, Ollama (http://host.docker.internal:11434/v1), dst.
# Kosongin LLM_API_KEY = fitur LLM mati, kalkulator tetap jalan deterministik.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# DeepSeek (Sep 2026): deepseek-flash (murah, thinking default ON) | deepseek-v4-pro (pintar, thinking default ON)
# alias lama: deepseek-chat = flash thinking OFF, deepseek-reasoner = flash thinking ON
LLM_MODEL=deepseek-flash
# on | off | kosong = default model. Bisa di-override per perintah: --thinking on|off
LLM_THINKING=
# low | medium | high | kosong = default. Cuma berlaku kalau thinking aktif. Override: --effort
LLM_REASONING_EFFORT=
# thinking bisa lama; 120 detik aman
LLM_TIMEOUT_MS=120000