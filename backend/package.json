{
  "name": "genshin-build-checker-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --exec \"tsx src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "scrape:kqm": "node scripts/scrape-kqm.mjs",
    "dump:gdb": "node scripts/dump-genshin-db.mjs",
    "test": "tsx --test src/lib/talentLabel.test.ts src/services/damage.service.test.ts src/services/damage.rules.test.ts src/services/damage.llm.test.ts src/services/benchmark.service.test.ts src/services/buffCheck.test.ts src/services/damage.snapshot.test.ts",
    "check:buffs": "tsx src/tools/checkBuffs.ts",
    "module:new": "tsx src/tools/newModule.ts",
    "snapshot:update": "tsx src/tools/snapshot.ts",
    "snapshot:check": "tsx src/tools/snapshot.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "genshin-db": "^5.2.13",
    "nodemon": "^3.1.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
